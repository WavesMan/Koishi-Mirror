# S3 配置
S3_ENDPOINT=https://your-s3-endpoint.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=your-region
S3_BUCKET=your-bucket-name
S3_PREFIX=packages/

# CDN 配置
CDNEnabled=true
CDNEndpoint=https://your-s3-cdn.com

# ICP 配置（可选）
ICPEnabled=false
ICPRecord=
ICPUrl=
SecurityRecord=
SecurityUrl=

# 同步配置
DATA_SOURCE_URL=https://ks-store.waveyo.cn/index.json
SYNC_INTERVAL=1h
SYNC_CONCURRENCY=10
SYNC_MAX_RETRIES=3
LogLevel=debug

# API 配置
API_PORT=8080

# Redis 缓存配置（可选）
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=10m

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=user
PG_PASSWORD=password
PG_DB=npm_mirror
PG_SSLMODE=disable

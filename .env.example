# TENCENT_COS 配置
TENCENT_COS_ENDPOINT=https://your-tencent-cos-endpoint.com
TENCENT_COS_ACCESS_KEY=your-access-key
TENCENT_COS_SECRET_KEY=your-secret-key
TENCENT_COS_REGION=your-region
TENCENT_COS_BUCKET=your-bucket-name
TENCENT_COS_PREFIX=packages/

# CDN 配置
CDNEnabled=true
CDNEndpoint=https://your-s3-cdn.com

# ICP 配置（可选）
ICPEnabled=false
ICPRecord=
ICPUrl=
SecurityRecord=
SecurityUrl=

# 同步配置
DATA_SOURCE_URL=https://ks-store.waveyo.cn/index.json
SYNC_INTERVAL=1h
SYNC_CONCURRENCY=10
SYNC_MAX_RETRIES=3
LogLevel=debug

# API 配置
API_PORT=8080

# Redis 缓存配置（可选）
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=10m

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=user
PG_PASSWORD=password
PG_DB=npm_mirror
PG_SSLMODE=disable

# Server 超时与头部限制
READ_TIMEOUT=10s
WRITE_TIMEOUT=20s
IDLE_TIMEOUT=60s
MAX_HEADER_BYTES=1048576

# 限流配置
RL_ENABLED=false
RL_GLOBAL_QPS=0
RL_PER_IP_QPS=0

# 本地缓存（可选）
LocalCacheEnabled=false
LocalCacheSize=10000
CacheSoftTTL=5m
